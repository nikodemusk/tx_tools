#!/usr/bin/env bash
# tx_exam – Bygg både elev- och lärarversion av prov (exam-klassen)

set -e

VERSION="2.4.0"
AUTHOR="Nikodemus Karlsson"

# Städa temporär katalog vid avbrott
cleanup() {
    if [[ -n "$TEMP_DIR" && -d "$TEMP_DIR" ]]; then
        rm -rf "$TEMP_DIR"
    fi
}
trap cleanup EXIT INT TERM

usage() {
    cat << EOF
tx_exam v$VERSION – Bygg både elev- och lärarversion av prov (exam-klassen)

Användning: 
  $0 [ALTERNATIV] [INPUT]

Alternativ:
  -i, --input FIL    Input .tex-fil (default: main.tex)
  -o, --output NAMN  Basnamn för output (default: från .latexmkrc eller input)
  -d, --output-dir   Output-katalog för PDF (default: out)
  -c, --clean        Rensa byggfiler (cache-katalogen)
  -v, --verbose      Visa detaljerad utskrift
  -h, --help         Visa hjälp
  --version          Visa version

Exempel:
  $0                              # main.tex → out/main_elev.pdf + out/main_larare.pdf
  $0 -i prov.tex                  # prov.tex → out/prov_elev.pdf + out/prov_larare.pdf
  $0 -o min_prov                  # main.tex → out/min_prov_elev.pdf + out/min_prov_larare.pdf
  $0 -c                           # Rensa cache-katalogen (byggfiler)
  $0 -v                           # Verbose läge för felsökning

Obs: Byggfiler (.log, .aux, etc.) sparas i cache/.
     Kör $0 -c för att rensa dem när projektet är klart.
EOF
}

# Defaultvärden
INPUT="main.tex"
OUTPUT_NAME=""
OUTPUT_DIR="out"
VERBOSE=false
CLEAN_MODE=false

# Parsa argument
while [[ $# -gt 0 ]]; do
    case "$1" in
        -i|--input)
            INPUT="$2"
            shift 2
            ;;
        -o|--output)
            OUTPUT_NAME="$2"
            shift 2
            ;;
        -d|--output-dir)
            OUTPUT_DIR="$2"
            shift 2
            ;;
        -c|--clean)
            CLEAN_MODE=true
            shift
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --version)
            echo "tx_exam version $VERSION"
            echo "Författare: $AUTHOR"
            exit 0
            ;;
        -*)
            echo "❌ Okänt alternativ: $1"
            usage
            exit 1
            ;;
        *)
            INPUT="$1"
            shift
            ;;
    esac
done

# Rensningsläge
if [[ "$CLEAN_MODE" == true ]]; then
    if [[ -d "cache" ]]; then
        echo "🧹 Rensar cache-katalogen (byggfiler)..."
        rm -rf cache
        echo "✅ Rensning klar"
    else
        echo "📭 Ingen cache-katalog att rensa"
    fi
    exit 0
fi

# Spara ursprungskatalogen
ORIGINAL_DIR="$(pwd)"

# Kontrollera att input-filen finns
if [[ ! -f "$INPUT" ]]; then
    echo "❌ Filen '$INPUT' finns inte!"
    exit 1
fi

# Bestäm OUTPUT_NAME med prioriteringsordning:
# 1. -o flagga
# 2. $jobname från .latexmkrc (om inte default 'jobname')
# 3. Basnamn på input-filen

if [[ -z "$OUTPUT_NAME" ]]; then
    if [[ -f ".latexmkrc" ]]; then
        # Använd awk för att extrahera värdet mellan citattecken
        JOBNAME=$(grep -E '^\$jobname' .latexmkrc | head -1 | awk -F"'" '{print $2}')
        
        # Använd endast om det inte är tomt eller default-värdet 'jobname'
        if [[ -n "$JOBNAME" && "$JOBNAME" != "jobname" ]]; then
            OUTPUT_NAME="$JOBNAME"
            [[ "$VERBOSE" == true ]] && echo "📖 Läste jobname från .latexmkrc: $OUTPUT_NAME"
        fi
    fi
fi

# Om fortfarande tomt, använd basnamnet på input
if [[ -z "$OUTPUT_NAME" ]]; then
    OUTPUT_NAME=$(basename "$INPUT" .tex)
fi

# Sanera OUTPUT_NAME: ta bort ogiltiga tecken för filnamn
OUTPUT_NAME=$(echo "$OUTPUT_NAME" | sed 's/[^a-zA-Z0-9_-]//g')

# Skapa output-katalog och cache-katalog
mkdir -p "$OUTPUT_DIR"
mkdir -p "cache"

# Skapa privat temporär katalog
if [[ -n "$TMPDIR" ]]; then
    TEMP_DIR=$(mktemp -d -p "$TMPDIR" 2>/dev/null || mktemp -d)
    chmod 700 "$TEMP_DIR" 2>/dev/null || true
elif [[ -n "$XDG_RUNTIME_DIR" ]]; then
    TEMP_DIR=$(mktemp -d -p "$XDG_RUNTIME_DIR" 2>/dev/null || mktemp -d)
    chmod 700 "$TEMP_DIR" 2>/dev/null || true
else
    PRIVATE_TEMP="$HOME/.cache/tx_exam"
    mkdir -p "$PRIVATE_TEMP"
    chmod 700 "$PRIVATE_TEMP" 2>/dev/null || true
    TEMP_DIR=$(mktemp -d -p "$PRIVATE_TEMP" 2>/dev/null || mktemp -d)
fi

BASENAME=$(basename "$INPUT" .tex)

echo "========================================="
echo "tx_exam v$VERSION"
echo "Input: $INPUT"
echo "Output-basnamn: $OUTPUT_NAME"
echo "Output-katalog: $OUTPUT_DIR"
[[ "$VERBOSE" == true ]] && echo "Verbose läge: PÅ"
echo "========================================="

# Kopiera HELA projektkatalogen
echo "📁 Kopierar hela projektet till temp-katalogen..."

if command -v rsync &> /dev/null; then
    rsync -a --exclude="out" --exclude="cache" --exclude=".git" \
          --exclude="*.log" --exclude="*.aux" --exclude="*.pdf" \
          ./ "$TEMP_DIR/"
else
    cp -r . "$TEMP_DIR/"
    rm -rf "$TEMP_DIR/out" "$TEMP_DIR/cache" "$TEMP_DIR/.git" 2>/dev/null || true
fi

# Skapa cache-katalog i temp för byggfiler
mkdir -p "$TEMP_DIR/cache"
mkdir -p "$TEMP_DIR/out"

# Funktion för att bygga med given preamble
bygg_med_preamble() {
    local version_type="$1"      # elev eller larare
    local preamble_file="$2"     # vilken preamble-fil som ska användas
    local output_suffix="$3"     # elev eller larare för filnamn
    
    echo "📝 Bygger ${version_type}version..."
    
    cd "$TEMP_DIR"
    
    # Skapa en modifierad main.tex som pekar på rätt preamble
    local temp_main="${OUTPUT_NAME}_${output_suffix}.tex"
    cp "$INPUT" "$temp_main"
    
    # Ändra \input{preamble} till \input{$preamble_file}
    perl -pi -e "s/\\\\input\{preamble\}/\\\\input{$preamble_file}/" "$temp_main"
    
    # Skapa länk till cache-katalogen (för att .latexmkrc ska hitta den)
    ln -sf "$TEMP_DIR/cache" "$TEMP_DIR/.cache" 2>/dev/null || true
    
    # Bygg första gången
    if [[ "$VERBOSE" == true ]]; then
        echo "  Kör lualatex (första passet)..."
        if ! lualatex -interaction=nonstopmode -halt-on-error "$temp_main"; then
            echo "  ❌ ${version_type}version misslyckades!"
            echo ""
            echo "  Fel från loggen:"
            grep -i "error\|!" "$(basename "$temp_main" .tex).log" 2>/dev/null | head -10
            return 1
        fi
    else
        if ! lualatex -interaction=nonstopmode -halt-on-error "$temp_main" > /dev/null 2>&1; then
            echo "  ❌ ${version_type}version misslyckades!"
            echo "  Kör med --verbose för att se felmeddelanden"
            return 1
        fi
    fi
    
    # Bygg andra gången
    if [[ "$VERBOSE" == true ]]; then
        echo "  Kör lualatex (andra passet)..."
        lualatex -interaction=nonstopmode -halt-on-error "$temp_main" > /dev/null 2>&1
    else
        lualatex -interaction=nonstopmode -halt-on-error "$temp_main" > /dev/null 2>&1
    fi
    
    # Leta efter genererad PDF
    local pdf_source=""
    local pdf_basename="$(basename "$temp_main" .tex)"
    
    if [[ -f "${pdf_basename}.pdf" ]]; then
        pdf_source="${pdf_basename}.pdf"
        echo "  Hittade ${pdf_source} i aktuell katalog"
    elif [[ -f "out/${pdf_basename}.pdf" ]]; then
        pdf_source="out/${pdf_basename}.pdf"
        echo "  Hittade ${pdf_source} i out/-katalogen"
    fi
    
    if [[ -n "$pdf_source" && -f "$pdf_source" ]]; then
        # Kopiera PDF till out/
        cp "$pdf_source" "$ORIGINAL_DIR/$OUTPUT_DIR/${OUTPUT_NAME}_${output_suffix}.pdf"
        echo "  ✅ ${version_type}version → ${OUTPUT_NAME}_${output_suffix}.pdf"
        
        # Kopiera byggfiler (.log, .aux, etc.) till cache/
        for ext in log aux fls fdb_latexmk; do
            if [[ -f "${pdf_basename}.${ext}" ]]; then
                cp "${pdf_basename}.${ext}" "$ORIGINAL_DIR/cache/${OUTPUT_NAME}_${output_suffix}.${ext}" 2>/dev/null || true
            fi
        done
        if [[ "$VERBOSE" == true ]]; then
            echo "  📄 Byggfiler sparade i cache/"
        fi
        return 0
    else
        echo "  ❌ ${version_type}version misslyckades (ingen PDF skapades)"
        return 1
    fi
}

# Elevversion (utan answers)
echo ""
echo "=== Elevversion (utan svar) ==="
cp "$TEMP_DIR/preamble.tex" "$TEMP_DIR/preamble_elev.tex"

perl -pi -e 's/answers,?//g' "$TEMP_DIR/preamble_elev.tex"
perl -pi -e 's/,,+/,/g' "$TEMP_DIR/preamble_elev.tex"
perl -pi -e 's/\[,/[/g' "$TEMP_DIR/preamble_elev.tex"

if [[ "$VERBOSE" == true ]]; then
    echo "  Documentclass-rad i preamble_elev.tex:"
    grep "documentclass" "$TEMP_DIR/preamble_elev.tex" || echo "  (ingen documentclass-rad hittad)"
fi

bygg_med_preamble "elev" "preamble_elev.tex" "elev"

# Lärarversion (med answers)
echo ""
echo "=== Lärarversion (med svar) ==="
cp "$TEMP_DIR/preamble.tex" "$TEMP_DIR/preamble_larare.tex"

perl -pi -e 's/\\documentclass\[/\\documentclass[answers,/' "$TEMP_DIR/preamble_larare.tex"

if [[ "$VERBOSE" == true ]]; then
    echo "  Documentclass-rad i preamble_larare.tex:"
    grep "documentclass" "$TEMP_DIR/preamble_larare.tex" || echo "  (ingen documentclass-rad hittad)"
fi

bygg_med_preamble "lärar" "preamble_larare.tex" "larare"

# Städa
cd "$ORIGINAL_DIR"
rm -rf "$TEMP_DIR"

echo ""
echo "========================================="

# Visa resultat
if [[ -f "$OUTPUT_DIR/${OUTPUT_NAME}_elev.pdf" ]]; then
    echo "✅ Elevversion:  $OUTPUT_DIR/${OUTPUT_NAME}_elev.pdf"
    ls -lh "$OUTPUT_DIR/${OUTPUT_NAME}_elev.pdf" | awk '{print "   Storlek: " $5}'
else
    echo "❌ Elevversion saknas"
fi

if [[ -f "$OUTPUT_DIR/${OUTPUT_NAME}_larare.pdf" ]]; then
    echo "✅ Lärarversion: $OUTPUT_DIR/${OUTPUT_NAME}_larare.pdf"
    ls -lh "$OUTPUT_DIR/${OUTPUT_NAME}_larare.pdf" | awk '{print "   Storlek: " $5}'
else
    echo "❌ Lärarversion saknas"
fi

echo ""
echo "💡 Byggfiler sparades i cache/"
echo "   Rensa med: tx_exam -c"

echo "========================================="
