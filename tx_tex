#!/usr/bin/env bash
set -e

VERSION="1.4.0"
AUTHOR="Nikodemus Karlsson"

# Defaultvärden
INPUT="main.tex"
FORMAT="pdf"
DPI=300
WATCH_MODE=false
CLEAN_MODE=false
CLEAN_JOBNAME=""
OUTPUT_NAME=""

# PNG-bakgrund
BG_COLOR="white"
BG_TRANSPARENT=false
TRIM=false

# Kontrollera beroenden
for cmd in lualatex latexmk; do
    if ! command -v $cmd &> /dev/null; then
        echo "❌ $cmd saknas."
        exit 1
    fi
done

# Läs in inställningar från .latexmkrc
LATEXMK_RC=".latexmkrc"
AUX_DIR=""
OUT_DIR=""
JOBNAME=""

if [[ -f "$LATEXMK_RC" ]]; then
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*% ]] && continue
        
        if [[ "$line" =~ \$aux_dir[[:space:]]*=[[:space:]]*[\'\"]([^\'\"]+)[\'\"] ]]; then
            AUX_DIR="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ \$aux_dir[[:space:]]*=[[:space:]]*([^[:space:];]+) ]]; then
            AUX_DIR="${BASH_REMATCH[1]}"
        fi
        
        if [[ "$line" =~ \$out_dir[[:space:]]*=[[:space:]]*[\'\"]([^\'\"]+)[\'\"] ]]; then
            OUT_DIR="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ \$out_dir[[:space:]]*=[[:space:]]*([^[:space:];]+) ]]; then
            OUT_DIR="${BASH_REMATCH[1]}"
        fi
        
        if [[ "$line" =~ \$jobname[[:space:]]*=[[:space:]]*[\'\"]([^\'\"]+)[\'\"] ]]; then
            JOBNAME="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ \$jobname[[:space:]]*=[[:space:]]*([^[:space:];]+) ]]; then
            JOBNAME="${BASH_REMATCH[1]}"
        fi
    done < "$LATEXMK_RC"
fi

AUX_DIR=$(echo "$AUX_DIR" | xargs)
OUT_DIR=$(echo "$OUT_DIR" | xargs)
JOBNAME=$(echo "$JOBNAME" | xargs)

if [[ -z "$JOBNAME" ]]; then
    JOBNAME="main"
fi

usage() {
  cat << EOF
tx_tex v$VERSION – Bygg LuaLaTeX-projekt till PDF eller PNG

Användning: $0 [ALTERNATIV]

ALTERNATIV:
  -i, --input FIL    Input .tex-fil (default: main.tex)
  -o, --output FIL   Output-fil (ange utan filändelse, t.ex. -o min_fil)
  -f, --format TYP   Välj "pdf" (default) eller "png"
  --dpi NUMMER       DPI för PNG (default: 300)
  --bg-color FÄRG    Bakgrundsfärg för PNG
  --bg-transparent   Transparent bakgrund
  --trim             Beskär marginal
  -w, --watch        Live-läge (endast PDF)
  -c, --clean [FIL]  Rensa byggfiler
  -h, --help         Visa hjälp
  --version          Visa version

EXEMPEL:
  tx_tex -i rapport.tex              # → out/rapport.pdf
  tx_tex -o min_fil                  # → out/min_fil.pdf
  tx_tex -i formel.tex -f png -o bild
EOF
}

# Parsa argument
while [[ $# -gt 0 ]]; do
  case "$1" in
    -i|--input)
      INPUT="$2"
      shift 2
      ;;
    -o|--output)
      OUTPUT_NAME="$2"
      shift 2
      ;;
    -f|--format)
      FORMAT="$2"
      shift 2
      ;;
    --dpi)
      DPI="$2"
      shift 2
      ;;
    --bg-color)
      BG_COLOR="$2"
      BG_TRANSPARENT=false
      shift 2
      ;;
    --bg-transparent)
      BG_TRANSPARENT=true
      shift
      ;;
    --trim)
      TRIM=true
      shift
      ;;
    -w|--watch)
      WATCH_MODE=true
      shift
      ;;
    -c|--clean)
      CLEAN_MODE=true
      if [[ -n "$2" && "$2" != -* ]]; then
        CLEAN_JOBNAME="$2"
        shift
      fi
      shift
      ;;
    --version)
      echo "tx_tex version $VERSION"
      exit 0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Okänt alternativ: $1"
      usage
      exit 1
      ;;
  esac
done

# Rensningsläge
if [[ "$CLEAN_MODE" == true ]]; then
  if [[ -n "$CLEAN_JOBNAME" ]]; then
    CLEAN_JOBNAME=$(basename "$CLEAN_JOBNAME" .tex)
    CLEAN_TARGET="$CLEAN_JOBNAME"
  else
    CLEAN_TARGET="$JOBNAME"
  fi
  echo "Rensar byggfiler för: $CLEAN_TARGET"
  
  if [[ -n "$OUT_DIR" ]]; then
    rm -f "${OUT_DIR}/${CLEAN_TARGET}.pdf" "${OUT_DIR}/${CLEAN_TARGET}.png" 2>/dev/null || true
  else
    rm -f "${CLEAN_TARGET}.pdf" "${CLEAN_TARGET}.png" 2>/dev/null || true
  fi
  
  TEMP_TEX="${CLEAN_TARGET}.tex"
  if [[ ! -f "$TEMP_TEX" ]]; then
    echo "% dummy" > "$TEMP_TEX"
    latexmk -C -cd "$TEMP_TEX" 2>/dev/null || true
    rm -f "$TEMP_TEX"
  else
    latexmk -C -cd "$TEMP_TEX" 2>/dev/null || true
  fi
  
  if [[ -n "$AUX_DIR" && -d "$AUX_DIR" ]]; then
    rm -f "${AUX_DIR}/${CLEAN_TARGET}".* 2>/dev/null || true
    rmdir "$AUX_DIR" 2>/dev/null || true
  fi
  
  echo "✅ Rensning klar"
  exit 0
fi

# Bestäm basnamn (utan filändelse)
if [[ -n "$OUTPUT_NAME" ]]; then
    # Ta bort eventuell .pdf eller .png om användaren skrivit det
    BASE_NAME=$(basename "$OUTPUT_NAME" .pdf)
    BASE_NAME=$(basename "$BASE_NAME" .png)
else
    BASE_NAME="$JOBNAME"
fi

# Sätt JOBNAME för latexmk
JOBNAME="$BASE_NAME"

# Validera format
if [[ "$FORMAT" != "pdf" && "$FORMAT" != "png" ]]; then
  echo "Fel: Format måste vara 'pdf' eller 'png'"
  exit 1
fi

# Watch-läge
if [[ "$WATCH_MODE" == true ]]; then
  if [[ "$FORMAT" != "pdf" ]]; then
    echo "Varning: Watch-läge endast för PDF. Växlar."
    FORMAT="pdf"
  fi
  echo "Startar live-läge för $INPUT (jobbnamn: $JOBNAME)..."
  latexmk -pvc -cd -jobname="$JOBNAME" "$INPUT"
  exit 0
fi

# Var PDF hamnar (enligt .latexmkrc)
if [[ -n "$OUT_DIR" ]]; then
    GENERATED_PDF="${OUT_DIR}/${JOBNAME}.pdf"
else
    GENERATED_PDF="${JOBNAME}.pdf"
fi

# Var slutgiltig output ska vara
if [[ -n "$OUT_DIR" ]]; then
    FINAL_PDF="${OUT_DIR}/${BASE_NAME}.pdf"
    FINAL_PNG="${OUT_DIR}/${BASE_NAME}.png"
else
    FINAL_PDF="${BASE_NAME}.pdf"
    FINAL_PNG="${BASE_NAME}.png"
fi

# Bygg PDF
echo "========================================="
echo "tx_tex v$VERSION"
echo "Bygger: $INPUT"
echo "Jobbnamn: $JOBNAME"
echo "========================================="

latexmk -cd -jobname="$JOBNAME" "$INPUT"

if [[ ! -f "$GENERATED_PDF" ]]; then
    echo "Fel: Kunde inte hitta $GENERATED_PDF"
    exit 1
fi

# Hantera output baserat på format
if [[ "$FORMAT" == "pdf" ]]; then
    # PDF-läge – filen är redan på rätt plats (i out_dir)
    echo "✅ Klar: $GENERATED_PDF"
else
    # PNG-läge – konvertera
    if ! command -v magick &> /dev/null; then
        echo "❌ ImageMagick saknas"
        exit 1
    fi
    
    echo "Konverterar $GENERATED_PDF → $FINAL_PNG ..."
    
    if [[ "$BG_TRANSPARENT" == true ]]; then
        magick -density $DPI "$GENERATED_PDF" -background none -flatten "$FINAL_PNG"
    else
        magick -density $DPI "$GENERATED_PNG" -background "$BG_COLOR" -flatten "$FINAL_PNG"
    fi
    
    if [[ "$TRIM" == true ]]; then
        magick "$FINAL_PNG" -trim "$FINAL_PNG"
    fi
    
    echo "✅ Klar: $FINAL_PNG"
fi
